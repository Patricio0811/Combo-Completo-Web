# Copia a .env (local) o define estas variables en el panel de Render/Railway
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vacío = SQLite local. Con PostgreSQL:
DATABASE_URL=postgres://postgres:root@localhost:5432/combo
# Clave Fernet para teléfono/dirección (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=
# Solo producción: https://tu-app.onrender.com
CSRF_TRUSTED_ORIGINS=
